# Session cookie
SESSION_COOKIE_NAME=__session
SESSION_COOKIE_MAX_AGE_DAYS=14

# Optional: path to a service account JSON (otherwise Application Default Credentials)
# GOOGLE_APPLICATION_CREDENTIALS=

